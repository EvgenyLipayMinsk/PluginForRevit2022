<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug R2022</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{95E98489-DDEB-4FFA-AC8C-B921AEF66EE5}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>PluginForRevit2022</RootNamespace>
    <AssemblyName>PluginForRevit2022</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!--
    One configuration per Revit version. Pick it in the VS toolbar (e.g. "Debug R2023"):
    the build references that version's RevitAPI, F5 starts that Revit,
    and a Debug build registers the add-in in %AppData%\Autodesk\Revit\Addins\<version>.
  -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug R2022|AnyCPU' ">
    <RevitVersion>2022</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug R2023|AnyCPU' ">
    <RevitVersion>2023</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug R2024|AnyCPU' ">
    <RevitVersion>2024</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release R2022|AnyCPU' ">
    <RevitVersion>2022</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release R2023|AnyCPU' ">
    <RevitVersion>2023</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release R2024|AnyCPU' ">
    <RevitVersion>2024</RevitVersion>
  </PropertyGroup>
  <!-- Settings shared by all versions -->
  <PropertyGroup>
    <RevitVersion Condition=" '$(RevitVersion)' == '' ">2022</RevitVersion>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
    <RevitAddinsDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinsDir>
    <IsDebugBuild>$(Configuration.StartsWith('Debug'))</IsDebugBuild>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(IsDebugBuild)' == 'true' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;REVIT$(RevitVersion)</DefineConstants>
    <!-- F5 launches the matching Revit instead of trying to run the DLL -->
    <StartAction>Program</StartAction>
    <StartProgram>$(RevitInstallDir)\Revit.exe</StartProgram>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(IsDebugBuild)' != 'true' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Transactions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="App.cs" />
    <Compile Include="CmdRemoveParameters.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Include="UserRemoveParameters.xaml.cs">
      <DependentUpon>UserRemoveParameters.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="PluginForRevit2022.addin" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="UserRemoveParameters.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="Resourses\Remove Parameters.png" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Clear error instead of dozens of "type not found" errors when that Revit is not installed -->
  <Target Name="CheckRevitApi" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll')">
    <Error Text="Revit $(RevitVersion) не найден: нет файла $(RevitInstallDir)\RevitAPI.dll. Установите Revit $(RevitVersion) или выберите другую конфигурацию." />
  </Target>
  <!-- Debug: copy the .addin manifest to Addins\<version> and point it at the freshly built DLL -->
  <Target Name="DeployRevitAddin" AfterTargets="Build" Condition=" '$(IsDebugBuild)' == 'true' ">
    <MakeDir Directories="$(RevitAddinsDir)" />
    <Copy SourceFiles="$(ProjectDir)PluginForRevit2022.addin" DestinationFolder="$(RevitAddinsDir)" />
    <XmlPoke XmlInputPath="$(RevitAddinsDir)\PluginForRevit2022.addin" Query="/RevitAddIns/AddIn/Assembly" Value="$(TargetPath)" />
    <Message Importance="high" Text="Revit $(RevitVersion) add-in manifest deployed: $(RevitAddinsDir)\PluginForRevit2022.addin" />
  </Target>
</Project>
